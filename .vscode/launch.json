    "version": "0.2.0",
    "configurations": [
        {
            "name": "调试 rdr-win64 (带参数)",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            // 指定你的 main.go 文件所在路径（根据实际情况调整）
            "program": "${workspaceFolder}/main.go",
            // 将命令行参数拆分成数组，按顺序填入
            "args": [
                "show",
                "-p",
                "8099",
                "dump.rdb"
            ],
            // 设置工作目录（默认是项目根目录，如果你的 dump.rdb 文件在根目录则无需修改）
            "cwd": "${workspaceFolder}",
            // 如果程序需要交互（例如读取 stdin），可取消下面注释启用终端
            // "console": "integratedTerminal"
        }
    ]
